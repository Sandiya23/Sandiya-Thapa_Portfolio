# Copy this file to `.env.local` (gitignored) and fill in your values from
# Supabase dashboard → Project Settings → API.
# Without these the site still works, using the built-in content in src/data/.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
